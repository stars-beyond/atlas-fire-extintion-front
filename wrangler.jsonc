// Deploy no Cloudflare Workers & Pages: só arquivos estáticos (o build do Vite em dist/).
// O site chama a API direto em https://api.atlas-stars-beyond.tech (VITE_API_URL, em .env.production).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-fire-extintion-front",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Exigido pelo `wrangler preview`, que o Cloudflare roda nos builds de PR/branch (fora da main).
  // Pode ficar vazio: assets e compatibility_date são herdados do nível de cima.
  "previews": {}
}
